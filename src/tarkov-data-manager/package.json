{
  "name": "tarkov-data-manager",
  "version": "2.0.1",
  "description": "",
  "main": "index.mjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node -r dotenv/config --trace-warnings test.mjs",
    "test:data": "node --test test/quest-correction-data.test.mjs",
    "test:build": "node --test test/build-artifact.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build:code": "tsc -p tsconfig.build.json",
    "build": "node scripts/build-artifact.mjs",
    "validate:build": "npm run build && npm run test:build && npm run test:data",
    "dev": "nodemon -r dotenv/config --trace-warnings index.mjs",
    "start": "node --enable-source-maps --max-old-space-size=3000 index.mjs",
    "start:build": "node scripts/start-build.mjs",
    "job": "node -r dotenv/config --trace-warnings test-job.mjs",
    "put-kvs": "node -r dotenv/config --trace-warnings populate-kvs.mjs",
    "kv-locale": "node -r dotenv/config --trace-warnings ./scripts/generate-kv-locale.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@aws-sdk/credential-providers": "^3.1070.0",
    "adm-zip": "^0.6.0",
    "body-parser": "^2.3.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cloudflare": "^6.4.0",
    "compute-midmean": "^1.0.3",
    "cookie-session": "^2.1.1",
    "cron-validator": "^1.4.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "filenamify": "^7.0.2",
    "formidable": "^3.5.4",
    "json-stream-stringify": "^3.1.7",
    "json5": "^2.2.3",
    "luxon": "^3.7.2",
    "mysql2": "^3.22.5",
    "node-schedule": "^2.1.1",
    "sharp": "^0.35.3",
    "tarkov-dev-image-generator": "^2.4.0",
    "unidecode": "^1.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "nodemon": "^3.1.14",
    "typescript": "5.9.3"
  },
  "nodemonConfig": {
    "ignore": [
      "package.json",
      "dumps",
      "cache",
      "data",
      "logs",
      "node-logs",
      "public",
      "build",
      "script",
      "scripts"
    ],
    "delay": 2500
  }
}
